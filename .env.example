# Copy to .env.production (build-time values; all public, nothing secret). See README.md.
VITE_PUSH_API=https://diin-push.YOUR-SUBDOMAIN.workers.dev
VITE_VAPID_PUBLIC_KEY=PASTE_THE_PUBLIC_KEY_FROM_npx_@pushforge/builder_vapid
